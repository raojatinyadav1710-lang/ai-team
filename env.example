# Copy these into Vercel > Project > Settings > Environment Variables.
# You only need the AI keys you actually have. Any key you skip is simply left out.

# Password for your site (so strangers can't burn your free credits)
ACCESS_CODE=pick-a-secret-word

# How many AIs answer together in Team mode (default 3; needs that many keys)
# TEAM_SIZE=3

# How much file text (characters) the AIs see per question. More = smarter on big files, but uses more credits.
# FILE_CHARS=12000

# --- AI keys (all have free tiers) ---
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional: change a model name if one is retired (defaults are built in)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# CEREBRAS_MODEL=llama-3.3-70b

# --- Cloudflare R2 (file storage #1) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Backblaze B2 (file storage #2, used if R2 fails) ---
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
